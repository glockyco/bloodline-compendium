<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bloodline</AssemblyName>
    <RootNamespace>Bloodline</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CUE4Parse" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bloodline.Tests" />
    <Content
      Include="../../releases.json"
      Link="releases.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="Content/mechanics.json"
      Link="mechanics.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="Content/measured-damage.json"
      Link="measured-damage.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="Content/harvest-presets.json"
      Link="harvest-presets.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../issues/known-issues.json"
      Link="known-issues.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
