{
	"name": "@bloodline/site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun ../scripts/build-site.mjs",
		"build:fixtures": "bun ../scripts/build-site.mjs --fixtures",
		"build:preview": "bun ../scripts/build-site.mjs --preview",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint . && stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write . ../scripts ../tools ../package.json ../renovate.json ../.github",
		"format:check": "prettier --check . ../scripts ../tools ../package.json ../renovate.json ../.github",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"deploy:preview": "bun ../scripts/deploy.mjs preview",
		"deploy:production": "bun ../scripts/deploy.mjs production",
		"deploy:versions": "wrangler versions list",
		"deploy:rollback": "wrangler rollback",
		"deploy:dry-run": "bun ../scripts/deploy.mjs production --dry-run",
		"deploy:preview:dry-run": "bun ../scripts/deploy.mjs preview --dry-run",
		"deploy:smoke": "bun ../scripts/deploy.mjs smoke",
		"review": "wrangler dev --assets build",
		"layout:check": "bun scripts/layout-check.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource/arbutus-slab": "^5.3.0",
		"@fontsource/young-serif": "^5.3.0",
		"@pagefind/component-ui": "1.5.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"ajv": "8.17.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"json-schema-to-typescript": "16.0.0",
		"pagefind": "1.5.2",
		"postcss-html": "^2.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "0.35.5",
		"stylelint": "^17.16.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "4.152.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0"
	}
}
